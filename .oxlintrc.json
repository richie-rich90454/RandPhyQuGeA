{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "options": {
        "typeAware": true
    },
    "plugins": ["typescript", "unicorn", "react", "react-perf", "jsx-a11y", "import", "vitest"],
    "categories": {
        "correctness": "error",
        "suspicious": "error",
        "perf": "warn",
        "style": "off",
        "pedantic": "off",
        "restriction": "off",
        "nursery": "off"
    },
    "env": {
        "builtin": true,
        "browser": true,
        "node": true
    },
    "ignorePatterns": ["dist", "src-tauri", "node_modules", "coverage"],
    "rules": {
        "react/rules-of-hooks": "error",
        "react/exhaustive-deps": "warn"
    },
    "overrides": [
        {
            "files": ["**/*.{test,spec}.{ts,tsx}", "**/__tests__/**/*.{ts,tsx}"],
            "rules": {
                "typescript/no-explicit-any": "off"
            }
        }
    ]
}
