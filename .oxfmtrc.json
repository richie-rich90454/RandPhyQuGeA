{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"tabWidth": 4,
	"semi": true,
	"singleQuote": false,
	"trailingComma": "all",
	"printWidth": 200,
	"bracketSpacing": false,
	"arrowParens": "avoid",
	"sortPackageJson": false,
	"ignorePatterns": ["node_modules", "dist", "src/wasm", "physics_core", "reference", "src-tauri", "*.lock", "package-lock.json"]
}
