{
    "name": "physics-question-generator",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "lint": "oxlint src",
        "lint:fix": "oxlint src --fix",
        "typecheck": "tsc --noEmit",
        "format:check": "oxfmt --check .",
        "format:write": "oxfmt --write .",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest",
        "clean": "node --input-type=commonjs -e \"const fs=require('fs');['dist','coverage','node_modules/.vite'].forEach(function(p){try{fs.rmSync(p,{recursive:true,force:true})}catch(e){}});console.log('Cleaned dist/, coverage/, node_modules/.vite')\"",
        "typecheck:watch": "tsc --noEmit --watch"
    },
    "dependencies": {
        "@fontsource/noto-sans": "^5.2.10",
        "@fontsource/noto-sans-mono": "^5.2.10",
        "katex": "^0.17.0",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "zustand": "^5.0.14"
    },
    "devDependencies": {
        "@types/katex": "^0.16.8",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.3",
        "@vitest/coverage-v8": "^4.1.9",
        "autoprefixer": "^10.5.2",
        "jsdom": "^29.1.1",
        "oxfmt": "^0.57.0",
        "oxlint": "^1.72.0",
        "oxlint-tsgolint": "^0.24.0",
        "postcss": "^8.5.15",
        "tailwindcss": "^4.3.2",
        "typescript": "^6.0.3",
        "vite": "^8.1.3",
        "vitest": "^4.1.9"
    }
}
